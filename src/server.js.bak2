/* =========================
   ARCHIVOS ESTÁTICOS
========================= */

app.use(express.static(PUBLIC));

app.use((req, res) => {
  res.sendFile(path.join(PUBLIC, 'dashboard.html'));
});

/* =========================
   ERROR HANDLER
========================= */

app.use((err, req, res, next) => {
  console.error('SERVER ERROR:', err);

  if (res.headersSent) {
    return next(err);
  }

  res.status(500).json({
    error: 'Error interno del servidor.'
  });
});

/* =========================
   START
========================= */

app.listen(PORT, '127.0.0.1', () => {
  console.log('');
  console.log('====================================');
