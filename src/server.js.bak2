require('dotenv').config();

const express = require('express');
const session = require('express-session');
const bcrypt = require('bcrypt');
const fs = require('fs');
const path = require('path');

const app = express();
const PORT = process.env.PORT || 3000;

const ROOT = path.join(__dirname, '..');
const DATA = path.join(ROOT, 'data');
const PUBLIC = path.join(ROOT, 'public');

const FILES = {
  menus: path.join(DATA, 'menus.json'),
  buttons: path.join(DATA, 'buttons.json'),
  messages: path.join(DATA, 'messages.json'),
  questions: path.join(DATA, 'questions.json'),
  types: path.join(DATA, 'types.json'),
  settings: path.join(DATA, 'settings.json'),
  activity: path.join(DATA, 'activity.json'),
  logs: path.join(DATA, 'logs.json'),
  servers: path.join(DATA, 'discord_servers.json'),
  publishQueue: path.join(DATA, 'publish_queue.json')
};

app.use(express.json({ limit: '5mb' }));
app.use(express.urlencoded({ extended: true }));

app.use(session({
  secret: process.env.SESSION_SECRET || 'tempered-dashboard-session',
  resave: false,
  saveUninitialized: false,
  cookie: {
    httpOnly: true,
    sameSite: 'lax'
  }
}));

function ensureFile(file, defaultValue) {
  if (!fs.existsSync(DATA)) fs.mkdirSync(DATA, { recursive: true });

  if (!fs.existsSync(file)) {
    fs.writeFileSync(file, JSON.stringify(defaultValue, null, 2));
  }
}

ensureFile(FILES.menus, []);
ensureFile(FILES.buttons, []);
ensureFile(FILES.messages, []);
ensureFile(FILES.questions, []);
ensureFile(FILES.types, []);
ensureFile(FILES.activity, []);
ensureFile(FILES.logs, []);
ensureFile(FILES.servers, []);
ensureFile(FILES.publishQueue, []);

ensureFile(FILES.settings, {
  bot: {
    name: 'TEMPERED',
    prefix: '!',
    activity: 'Tempered',
    status: 'online'
  },
  presentation: {
    title: 'TEMPERED - Roblox',
    description: 'Selecciona la información que quieres saber aquí. ↓',
    image: ''
  },
  appearance: {
    name: 'TEMPERED DASHBOARD',
    logo: '',
    background: '',
    primaryColor: '#b00000',
    secondaryColor: '#080808',
    accentColor: '#d4af37',
    refresh: 30
  }
});

function readJSON(file, fallback) {
  try {
    if (!fs.existsSync(file)) {
      fs.writeFileSync(file, JSON.stringify(fallback, null, 2));
      return fallback;
    }

    const raw = fs.readFileSync(file, 'utf8').trim();

    if (!raw) return fallback;

    return JSON.parse(raw);
  } catch (error) {
    console.error('Error leyendo:', file, error.message);
    return fallback;
  }
}

function writeJSON(file, data) {
  fs.writeFileSync(file, JSON.stringify(data, null, 2));
}

function createId(prefix = 'item') {
  return `${prefix}_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
}

function now() {
  return new Date().toISOString();
}

function addLog(action, details = {}, type = 'system') {
  const logs = readJSON(FILES.logs, []);

  logs.unshift({
    id: createId('log'),
    action,
    details,
    type,
    time: now()
  });

  writeJSON(FILES.logs, logs.slice(0, 500));
}

function addActivity(action, details = {}) {
  const activity = readJSON(FILES.activity, []);

  activity.unshift({
    id: createId('activity'),
    action,
    details,
    time: now()
  });

  const cutoff = Date.now() - (30 * 60 * 1000);

  const filtered = activity.filter(item => {
    return new Date(item.time).getTime() >= cutoff;
  });

  writeJSON(FILES.activity, filtered.slice(0, 200));
}

function requireAuth(req, res, next) {
  if (req.session && req.session.authenticated) {
    return next();
  }

  res.status(401).json({
    error: 'No autorizado.'
  });
}

function findIndexById(items, id) {
  return items.findIndex(item => String(item.id) === String(id));
}

function cleanObject(data) {
  if (!data || typeof data !== 'object') return {};
  return data;
}

/* =========================
   LOGIN
========================= */

app.post('/api/login', async (req, res) => {
  try {
    const password = String(req.body.password || '');
    const adminPassword = String(process.env.ADMIN_PASSWORD || '');

    if (!password || !adminPassword) {
      return res.status(500).json({
        error: 'La contraseña del administrador no está configurada.'
      });
    }

    let valid = password === adminPassword;

    if (!valid) {
      try {
        valid = await bcrypt.compare(password, adminPassword);
      } catch (_) {}
    }

    if (!valid) {
      return res.status(401).json({
        error: 'Contraseña incorrecta.'
      });
    }

    req.session.authenticated = true;

    res.json({
      ok: true
    });

    addLog('Inicio de sesión', {}, 'security');
  } catch (error) {
    console.error(error);

    res.status(500).json({
      error: 'Error interno.'
    });
  }
});

app.post('/api/logout', (req, res) => {
  if (!req.session) {
    return res.json({ ok: true });
  }

  req.session.destroy(() => {
    res.json({ ok: true });
  });
});

app.post('/logout', (req, res) => {
  if (!req.session) {
    return res.redirect('/login');
  }

  req.session.destroy(() => {
    res.redirect('/login');
  });
});

app.get('/api/auth', (req, res) => {
  res.json({
    authenticated: !!(req.session && req.session.authenticated)
  });
});

/* =========================
   STATUS
========================= */

app.get('/api/status', requireAuth, (req, res) => {
  const servers = readJSON(FILES.servers, []);

  let botOnline = false;

  try {
    if (fs.existsSync(FILES.servers)) {
      const stat = fs.statSync(FILES.servers);
      const age = Date.now() - stat.mtimeMs;

      /*
       * bot.js actualiza discord_servers.json cada 60 segundos.
       * Si el archivo fue actualizado recientemente y contiene
       * servidores, consideramos que el bot está conectado.
       */
      botOnline = servers.length > 0 && age < 150000;
    }
  } catch (_) {
    botOnline = servers.length > 0;
  }

  res.json({
    online: botOnline,
    status: botOnline ? 'ONLINE' : 'OFFLINE',
    servers: servers.length,
    serverCount: servers.length,
    timestamp: now()
  });
});

/* =========================
   MENUS
========================= */

app.get('/api/menus', requireAuth, (req, res) => {
  res.json(readJSON(FILES.menus, []));
});

app.post('/api/menus', requireAuth, (req, res) => {
  const menus = readJSON(FILES.menus, []);

  const body = cleanObject(req.body);

  const menu = {
    id: body.id || createId('menu'),
    name: body.name || body.title || 'Nuevo menú',
    title: body.title || body.name || 'Nuevo menú',
    description: body.description || '',
    image: body.image || '',
    emoji: body.emoji || '',
    parentId: body.parentId || body.parentMenuId || null,
    enabled: body.enabled !== false,
    buttons: Array.isArray(body.buttons) ? body.buttons : [],
    createdAt: body.createdAt || now(),
    updatedAt: now()
  };

  menus.push(menu);
  writeJSON(FILES.menus, menus);

  addActivity('Menú creado', {
    menuId: menu.id,
    name: menu.name
  });

  addLog('Menú creado', {
    menuId: menu.id,
    name: menu.name
  });

  res.json(menu);
});

app.put('/api/menus/:id', requireAuth, (req, res) => {
  const menus = readJSON(FILES.menus, []);
  const index = findIndexById(menus, req.params.id);

  if (index === -1) {
    return res.status(404).json({
      error: 'Menú no encontrado.'
    });
  }

  menus[index] = {
    ...menus[index],
    ...cleanObject(req.body),
    id: menus[index].id,
    updatedAt: now()
  };

  writeJSON(FILES.menus, menus);

  addActivity('Menú actualizado', {
    menuId: menus[index].id
  });

  res.json(menus[index]);
});

app.delete('/api/menus/:id', requireAuth, (req, res) => {
  let menus = readJSON(FILES.menus, []);

  const exists = menus.some(item =>
    String(item.id) === String(req.params.id)
  );

  if (!exists) {
    return res.status(404).json({
      error: 'Menú no encontrado.'
    });
  }

  menus = menus.filter(item =>
    String(item.id) !== String(req.params.id)
  );

  /*
   * También quitamos este menú como padre de otros menús.
   */
  menus = menus.map(menu => ({
    ...menu,
    parentId:
      String(menu.parentId) === String(req.params.id)
        ? null
        : menu.parentId
  }));

  writeJSON(FILES.menus, menus);

  addActivity('Menú eliminado', {
    menuId: req.params.id
  });

  addLog('Menú eliminado', {
    menuId: req.params.id
  });

  res.json({ ok: true });
});

