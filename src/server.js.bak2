/* =========================
   SERVIDORES DISCORD
========================= */

app.get('/api/discord/servers', requireAuth, (req, res) => {
  const servers = readJSON(FILES.servers, []);

  res.json(servers);
});

app.get('/api/discord/servers/:serverId/channels', requireAuth, (req, res) => {
  const servers = readJSON(FILES.servers, []);

  const server = servers.find(item =>
    String(item.id) === String(req.params.serverId)
  );

  if (!server) {
    return res.status(404).json({
      error: 'Servidor no encontrado.'
    });
  }

  const channels = Array.isArray(server.channels)
    ? server.channels.filter(channel =>
        channel.type === 0 || channel.type === 5
      )
    : [];

  res.json(channels);
});

/* =========================
   PUBLICAR MENÚ
========================= */

app.post('/api/menus/:id/publish', requireAuth, (req, res) => {
  const menus = readJSON(FILES.menus, []);
  const queue = readJSON(FILES.publishQueue, []);

  const menu = menus.find(item =>
    String(item.id) === String(req.params.id)
  );

  if (!menu) {
    return res.status(404).json({
      error: 'Menú no encontrado.'
    });
  }

  const body = cleanObject(req.body);

  if (!body.serverId || !body.channelId) {
    return res.status(400).json({
      error: 'Debes seleccionar servidor y canal.'
    });
  }

  const item = {
    id: createId('publish'),
    menuId: menu.id,
    serverId: body.serverId,
    channelId: body.channelId,
    status: 'pending',
    createdAt: now()
  };

  queue.push(item);
  writeJSON(FILES.publishQueue, queue);

  addActivity('Publicación solicitada', {
    menuId: menu.id,
    serverId: body.serverId,
    channelId: body.channelId
  });

  addLog('Publicación solicitada', {
    menuId: menu.id,
    serverId: body.serverId,
    channelId: body.channelId
  });

  res.json({
    ok: true,
    queued: true,
    item
  });
});

