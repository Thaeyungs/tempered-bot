/* =========================
   PREGUNTAS
========================= */

app.get('/api/questions', requireAuth, (req, res) => {
  res.json(readJSON(FILES.questions, []));
});

app.post('/api/questions', requireAuth, (req, res) => {
  const questions = readJSON(FILES.questions, []);
  const body = cleanObject(req.body);

  const relatedWords = Array.isArray(body.relatedWords)
    ? body.relatedWords
    : (
      typeof body.relatedWords === 'string'
        ? body.relatedWords
            .split(',')
            .map(x => x.trim())
            .filter(Boolean)
        : []
    );

  const question = {
    id: body.id || createId('question'),
    question: body.question || '',
    relatedWords,
    answer: body.answer || '',
    typeId: body.typeId || null,
    enabled: body.enabled !== false,
    createdAt: now(),
    updatedAt: now()
  };

  questions.push(question);
  writeJSON(FILES.questions, questions);

  addActivity('Pregunta creada', {
    questionId: question.id
  });

  res.json(question);
});

app.put('/api/questions/:id', requireAuth, (req, res) => {
  const questions = readJSON(FILES.questions, []);
  const index = findIndexById(questions, req.params.id);

  if (index === -1) {
    return res.status(404).json({
      error: 'Pregunta no encontrada.'
    });
  }

  const body = cleanObject(req.body);

  let relatedWords = body.relatedWords;

  if (typeof relatedWords === 'string') {
    relatedWords = relatedWords
      .split(',')
      .map(x => x.trim())
      .filter(Boolean);
  }

  questions[index] = {
    ...questions[index],
    ...body,
    ...(Array.isArray(relatedWords) ? { relatedWords } : {}),
    id: questions[index].id,
    updatedAt: now()
  };

  writeJSON(FILES.questions, questions);

  res.json(questions[index]);
});

app.delete('/api/questions/:id', requireAuth, (req, res) => {
  let questions = readJSON(FILES.questions, []);

  questions = questions.filter(item =>
    String(item.id) !== String(req.params.id)
  );

  writeJSON(FILES.questions, questions);

  addActivity('Pregunta eliminada', {
    questionId: req.params.id
  });

  res.json({ ok: true });
});

